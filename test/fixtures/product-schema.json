{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$comment": "Required Product/Offer fields for this tracker, based on https://developers.google.com/search/docs/appearance/structured-data/product-snippet . This is not a complete schema.org vocabulary or a Rich Results Test replacement.",
  "type": "object",
  "required": ["@context", "@type", "name", "offers"],
  "properties": {
    "@context": {"const": "https://schema.org"},
    "@type": {"const": "Product"},
    "name": {"type": "string", "minLength": 1},
    "offers": {
      "anyOf": [
        {"$ref": "#/definitions/offer"},
        {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/offer"}}
      ]
    }
  },
  "definitions": {
    "offer": {
      "type": "object",
      "required": ["@type", "price", "priceCurrency", "availability", "url"],
      "properties": {
        "@type": {"const": "Offer"},
        "price": {"type": "number", "exclusiveMinimum": 0},
        "priceCurrency": {"type": "string", "pattern": "^[A-Z]{3}$"},
        "availability": {"enum": ["https://schema.org/InStock", "https://schema.org/OutOfStock", "https://schema.org/PreOrder", "https://schema.org/BackOrder"]},
        "url": {"type": "string", "pattern": "^https://store\\.steampowered\\.com/"}
      }
    }
  }
}
